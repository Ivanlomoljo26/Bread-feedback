{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Renaming this creates a NEW Worker — secrets are per-Worker and write-only,
  // so all six must be re-put before the new one can serve a submission. The
  // `miden-feedback-relay` half of the URL is the ACCOUNT-level workers.dev
  // subdomain and does not change with it.
  // The D1 database keeps its own name (miden-feedback-v2-db) on purpose: it is
  // an account-level resource holding the mirror, and renaming it would mean
  // creating an empty one.
  "name": "bread-feedback-form",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // Serve public/ from this same Worker. The form's API base is '' (see
  // public/index.html), so it posts to /submit on whatever origin served it —
  // same-origin by construction, which is what makes ALLOWED_ORIGIN defence in
  // depth rather than the thing holding the door shut.
  //
  // A request matching a file in public/ is served by the asset worker; every
  // other path falls through to src/index.ts, so /submit, /status, /health and
  // /admin/backfill are unaffected. public/ contains only index.html, so no
  // asset can shadow an API route.
  "assets": { "directory": "./public" },

  "vars": {
    "TARGET_REPO": "Ivanlomoljo26/Jovan-GitHub-",
    "OPERATOR_HANDLE": "Ivanlomoljo26",
    "PIPELINE_VERSION": "v2",
    "MARKER_PREFIX": "mfv2",

    // Public base URL for the R2 bucket. Used as the attachment fallback when
    // GitHub's undocumented upload endpoint fails. Leave empty to disable.
    "R2_PUBLIC_BASE": "",

    // KILL SWITCH. Set to "false" and redeploy to halt every GitHub write
    // immediately. Ingest, dedup and storage keep running; nothing is lost.
    "PUBLISH_ENABLED": "true",

    // Volume caps — the primary abuse control, not defence in depth.
    // Exceeding them defers the submission; it never drops it.
    "CAP_PER_HOUR": "200",
    "CAP_PER_DAY": "800",

    // Classification gates
    "DUP_THRESHOLD": "0.85",     // >= this, fold into the matched issue
    "REVIEW_THRESHOLD": "0.60",  // between the two, fold but flag
    "COMMENT_THRESHOLD": "3",    // duplicates before a rolling comment appears

    // Drain loop. Submissions claimed per tick — the free plan allows 50
    // subrequests per invocation and one submission can spend six or seven,
    // so this stays small. Raise only with that ceiling in mind.
    //
    // 5/tick x 60 ticks = 300 issues/hour, above CAP_PER_HOUR (200) so the cap
    // is the binding limit rather than the drain. 5 x ~7 = ~35 subrequests,
    // leaving room for the mirror cron and retries; 7 would sit on the 50 wall.
    "DRAIN_BATCH_SIZE": "5",
    // Error retries before a submission is parked in state `failed`.
    // Deferrals (cap closed, classifier down, GitHub rate limited) do not
    // count against it.
    "MAX_ATTEMPTS": "5",

    // Accepted submissions per hour, per install id (per IP when no install
    // id is sent). Counts only submissions that PASSED Turnstile — a rejected
    // challenge costs nothing. This bounds casual flooding; Turnstile is the
    // real gate and CAP_PER_HOUR is the hard ceiling on GitHub writes.
    "RATE_LIMIT_PER_HOUR": "20"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "miden-feedback-v2-db", "database_id": "d0c90211-ab65-4fb3-af5b-cce82f8babf7" }
  ],

  // No "queues" block: Queues requires the paid Workers plan. The drain cron
  // below replaces it, with retries and the DLQ kept in D1 columns instead.
  // Queues mfv2-triage + mfv2-dlq still exist on the account, unused, ready
  // for a revert to tag `queue-design` if this upgrades to Workers Paid.

  // Workers AI — embeddings for paraphrase-aware dedup (@cf/baai/bge-small-en-v1.5,
  // 384 dims). On the free tier: 10,000 Neurons/day, and this model costs 1,841
  // Neurons per million input tokens. No extra key, no extra dependency.
  "ai": { "binding": "AI" },

  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "mfv2-attachments" }],

  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "PUBLISH_GATE", "class_name": "PublishGate" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter", "PublishGate"] }],

  // Every minute: drain pending submissions. Every 15: sync the issue mirror.
  // src/index.ts branches on controller.cron, and MIRROR_CRON there must match
  // the second entry character for character.
  "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },
  "observability": { "enabled": true }
}
